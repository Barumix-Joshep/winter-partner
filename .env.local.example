NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 웹푸시 (P8-2). 키 만들기: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://winter-partner.vercel.app
# 서비스 주소 (P24-1). 공유 링크(동의·셀프 등록 QR·가입 안내)에 쓴다. 비우면 요청 주소를 쓴다.
# 운영은 도메인 전환 때 사장님이 Vercel Production에 https://winter-partner.co.kr 로 넣는다 (docs/domain-cutover.md)
SITE_URL=
# 알림 재발송 주기 작업 (Vercel Cron)이 쓰는 비밀값
CRON_SECRET=

# AI 기능 (P14). 없으면 모든 AI 기능이 꺼지고 수동 흐름으로 동작한다. Vercel production에만 넣는다.
# 키는 https://console.anthropic.com 에서 발급. 저장소·대화에 붙여 넣지 않는다.
ANTHROPIC_API_KEY=
# 비용 상한·모델명·기능 기본값은 환경변수가 아니라 DB 설정(private.app_settings의 ai_*)과 /admin/ai 화면에서 관리한다.
# 로컬·E2E에서 실제 API 대신 가짜 모델을 쓴다 (운영에는 넣지 않는다)
AI_MOCK=

# AI 상담 (P22). 채널 토큰·손님 연락처 암호화(AES-256-GCM)와 손님 카카오·인스타 id 해시(HMAC-SHA256)에 쓴다.
# 값은 여기·저장소·대화에 적지 않는다. 운영 값은 사장님이 Vercel 환경변수에 넣는다. 한 번 정한 값을 바꾸면 저장된 값을 풀 수 없다.
# CONSULT_ENCRYPTION_KEY: base64로 적은 32바이트 (만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# CONSULT_HASH_KEY: 32자 이상 무작위 문자열 (만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CONSULT_ENCRYPTION_KEY=
CONSULT_HASH_KEY=

# 인스타그램 DM 상담 (P22-4, Instagram 로그인 방식). 셋 중 하나라도 없으면(또는 위 CONSULT_* 가 없으면) 인스타 기능 전체가 꺼진다
# (웹훅·연결 주소 404, 화면 "준비 중"). 값 만드는 법·메타 앱 준비는 docs/meta-setup.md. 값은 여기·저장소·대화에 적지 않는다.
# META_APP_ID: 메타 앱 → Instagram → API 설정의 Instagram 앱 ID
# META_APP_SECRET: 같은 화면의 Instagram 앱 시크릿 (웹훅 서명 검증·토큰 교환)
# META_VERIFY_TOKEN: 웹훅 등록 때 사장님이 정한 확인 토큰(메타 화면에 넣은 값과 같게)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Human Agent 심사를 통과한 뒤에만 1 (24시간~7일 대화에 사장님 승인 답장). 없으면 꺼짐
META_HUMAN_AGENT=
# Graph API 버전 (비우면 v24.0). 시험용 META_GRAPH_BASE·META_OAUTH_BASE는 운영에 넣지 않는다
