{
  "name": "winter-partner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "security": "node scripts/security-check.mjs",
    "e2e": "playwright test",
    "check:prod": "node scripts/check-prod.mjs",
    "ai:eval": "AI_EVAL=1 node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run src/lib/ai/intake.eval.test.ts",
    "e2e:prod": "node --env-file=.env.local --env-file=.env.rehearsal.local node_modules/@playwright/test/cli.js test -c playwright.prod.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "exceljs": "^4.4.0",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
